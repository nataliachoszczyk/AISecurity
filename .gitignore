# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data and model weights are on Kaggle, not in git
**/data/*
!**/data/.gitkeep
*.pt
*.pth
*.ckpt
*.zip

# Local tools
CLAUDE.local.md
.claude/settings.local.json
kaggle.json
# Kaggle token of one project (jobs/kaggle.sh)
.kaggle/
.vscode/
.idea/

# OS files
*:Zone.Identifier
.DS_Store

# Submissions stay local: the repository is public
**/submissions/*.csv

# Kaggle outputs: only small results go into git. Images can show task data, and the repository is public.
**/jobs/runs/*/output/**/*.npy
**/jobs/runs/*/output/**/*.npz
**/jobs/runs/*/output/**/*.png
**/jobs/runs/*/output/**/*.log
**/jobs/runs/*/output/**/submission_*.csv

# pro2: the large raw tables of the model EDA stay local
pro2-backdoor-detection/jobs/runs/2026-11-11_02_model-eda/output/model-eda/classes.csv
pro2-backdoor-detection/jobs/runs/2026-11-11_02_model-eda/output/model-eda/layers.csv
pro2-backdoor-detection/jobs/runs/2026-11-11_02_model-eda/output/model-eda/models.csv
pro2-backdoor-detection/jobs/runs/2026-11-11_02_model-eda/output/model-eda/similarity.csv
