# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data and model weights are on Kaggle, not in git
**/data/*
!**/data/.gitkeep
*.pt
*.pth
*.ckpt
*.zip

# Local tools
CLAUDE.local.md
.claude/settings.local.json
kaggle.json
.vscode/
.idea/

# OS files
*:Zone.Identifier
.DS_Store

# Submissions stay local: the repository is public
**/submissions/*.csv

# Kaggle outputs: only small results go into git. Images can show task data, and the repository is public.
**/jobs/*/output/**/*.npy
**/jobs/*/output/**/*.npz
**/jobs/*/output/**/*.png
**/jobs/*/output/**/*.log
**/jobs/*/output/**/submission_*.csv
